{
  "name": "sirius-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspace @sirius-ui/theme && npm run build --workspace @sirius-ui/vue",
    "typecheck": "npm run typecheck --workspace @sirius-ui/vue",
    "test": "npm run build --workspace @sirius-ui/theme && node --test packages/theme/tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && node --test packages/theme/tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vue-tsc": "^3.1.0"
  }
}
