{
  "name": "@sirius-ui/website",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Vue website layouts and sections for SiriusUI.",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@sirius-ui/theme": "0.1.0-alpha.1",
    "@sirius-ui/vue": "0.1.0-alpha.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "private": true
}
